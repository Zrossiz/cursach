generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  cards Card[]

  @@map("users")
}

model Card {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id")
  name   String

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardCashbackRules CardCashbackRule[]

  @@map("cards")
}

model ProductCategory {
  id      Int    @id @default(autoincrement())
  name    String
  imgPath String @map("img_path") @default("")
  slug    String @unique

  goods             Good[]
  cardCashbackRules CardCashbackRule[]

  @@map("product_categories")
}

model Good {
  id                Int     @id @default(autoincrement())
  productCategoryId Int     @map("product_category_id")
  name              String
  imgPath           String  @map("img_path")
  price             Decimal @db.Decimal(10, 2)

  productCategory ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@map("goods")
}

model BankCashbackCategory {
  id   Int    @id @default(autoincrement())
  name String

  cardCashbackRules CardCashbackRule[]

  @@map("bank_cashback_categories")
}

model CardCashbackRule {
  id                     Int @id @default(autoincrement())
  cardId                 Int @map("card_id")
  bankCashbackCategoryId Int @map("bank_cashback_category_id")
  productCategoryId      Int @map("product_category_id")
  percent                Int

  card                 Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  bankCashbackCategory BankCashbackCategory @relation(fields: [bankCashbackCategoryId], references: [id], onDelete: Cascade)
  productCategory      ProductCategory      @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@unique([cardId, bankCashbackCategoryId, productCategoryId])
  @@map("card_cashback_rules")
}
